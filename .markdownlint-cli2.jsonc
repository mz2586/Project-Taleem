{
  // Markdown lint config for the Taleem blueprint. See docs/07-engineering/42-documentation-standards.md
  "config": {
    "default": true,
    "MD013": false,        // line-length: prose wraps naturally; tables/links exceed 80
    "MD033": false,        // allow inline HTML (e.g. <div align> in README, <br>)
    "MD024": { "siblings_only": true }, // allow repeated headings (Change Log / Open Questions) across docs
    "MD041": false,        // first line need not be H1 (metadata blocks / HTML banners)
    "MD046": false         // allow both fenced and indented code
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**"]
}
