{
  "root": true,
  "extends": ["next/core-web-vitals", "plugin:jsx-a11y/strict"],
  "rules": {
    "jsx-a11y/aria-role": ["error", { "ignoreNonDOM": true }],
    "jsx-a11y/label-has-associated-control": ["error", { "assert": "either", "depth": 4 }]
  },
  "ignorePatterns": [".next/", "node_modules/", "public/sw.js", "next-env.d.ts"]
}
