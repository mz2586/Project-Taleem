{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 -m venv /tmp/migvenv && env -u PYTHONPATH /tmp/migvenv/bin/pip install -q -r requirements.txt httpx==0.28.1 && env -u PYTHONPATH /tmp/migvenv/bin/python scripts/vercel_migrate.py",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/health/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/metrics",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/jwks.json",
      "destination": "/api/index"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/index"
    }
  ],
  "outputDirectory": "public"
}
